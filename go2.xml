<mujoco model="go2">
  <!-- Menagerie unitree_go2 @ 6346b93, edited. Values tracked in tools/go2_constants.py.
       Joints/motors are inlined and defaults are flat on purpose: Drake merges a default
       class with its immediate parent only, so nesting silently loses attributes.

       Carries the sensors and foot sites so consumers do not have to add them.
       Adding a duplicate name is a hard compile error, so a consumer that used to
       inject its own must drop that code. -->

  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <!-- MuJoCo-only; ignored by Drake. -->
  <option cone="elliptic" impratio="100"/>

  <default>
    <default class="visual">
      <geom type="mesh" contype="0" conaffinity="0" group="2"/>
    </default>
    <default class="collision">
      <!-- condim=3, not upstream's 1: Drake substitutes 3 anyway, so 1 desynced them.
           margin=0, not upstream's 0.001: margin shifts contact force onset outward,
           and Drake has no equivalent, so a nonzero value makes MuJoCo touch down
           first. Raise it in a landing scene if the solver ever needs it. -->
      <geom group="3" condim="3" friction="0.6" margin="0"/>
    </default>
    <default class="foot">
      <!-- priority/solimp/condim=6/torsional friction are MuJoCo-only; Drake sees
           condim=3, mu=0.8. -->
      <geom type="sphere" size="0.022" pos="-0.002 0 -0.213" group="3" priority="1"
        solimp="0.015 1 0.022" condim="6" friction="0.8 0.02 0.01" margin="0"/>
    </default>
  </default>

